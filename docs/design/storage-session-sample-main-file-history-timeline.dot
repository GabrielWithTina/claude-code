// Readable timeline/table view for file-history snapshots in the sample main-agent session.
// Source: /home/xiaos/.claude/projects/-home-xiaos-git-gabriel-python/cd51bba4-3e67-4577-9a9c-1293e0100eff.jsonl
//
// Render example:
//   dot -Tsvg docs/design/storage-session-sample-main-file-history-timeline.dot -o /tmp/storage-session-sample-main-file-history-timeline.svg
//
// This is intentionally a table diagram, not an edge graph. The edge graph version
// is faithful, but it is hard to read because file-history snapshots repeatedly
// point at the same message/file-state nodes.

digraph sample_main_session_file_history_timeline {
  graph [
    label="Sample main-agent file-history snapshot timeline\ncd51bba4-3e67-4577-9a9c-1293e0100eff",
    labelloc=t,
    fontsize=22,
    rankdir=TB
  ];

  node [shape=plain, fontname="Menlo"];

  timeline [
    label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8">
