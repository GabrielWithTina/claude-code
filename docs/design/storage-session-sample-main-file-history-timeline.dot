          <TD BGCOLOR="#333333"><FONT COLOR="white"><B>Tracked backup state</B></FONT></TD>
          <TD BGCOLOR="#333333"><FONT COLOR="white"><B>Meaning</B></FONT></TD>
        </TR>

        <TR>
